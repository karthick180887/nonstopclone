{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/blog/[slug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/city/[city]",
      "regex": "^/city/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcity": "nxtPcity"
      },
      "namedRegex": "^/city/(?<nxtPcity>[^/]+?)(?:/)?$"
    },
    {
      "page": "/city/[city]/[dropSlug]",
      "regex": "^/city/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcity": "nxtPcity",
        "nxtPdropSlug": "nxtPdropSlug"
      },
      "namedRegex": "^/city/(?<nxtPcity>[^/]+?)/(?<nxtPdropSlug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[slug]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/booking",
      "regex": "^/booking(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/booking(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/faq",
      "regex": "^/faq(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/faq(?:/)?$"
    },
    {
      "page": "/fleet",
      "regex": "^/fleet(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fleet(?:/)?$"
    },
    {
      "page": "/gk-web-designs",
      "regex": "^/gk\\-web\\-designs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/gk\\-web\\-designs(?:/)?$"
    },
    {
      "page": "/one-way-taxi",
      "regex": "^/one\\-way\\-taxi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/one\\-way\\-taxi(?:/)?$"
    },
    {
      "page": "/pricing",
      "regex": "^/pricing(?:/)?$",
